{
  "expo": {
    "name": "NimueBlue",
    "slug": "mirlo-blue",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/nimue-blue-icon.png",
    "scheme": "nimueblue",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "space.mirlo.blue",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/nimue-blue-adaptive.png",
        "backgroundColor": "#070b14"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "space.mirlo.blue",
      "versionCode": 16
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/nimue-blue-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#070b14"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow NimueBlue to access your Face ID biometric data."
        }
      ],
      "expo-localization",
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Medieval-Scroll-of-Wisdom.ttf",
            "./assets/fonts/OpenSans-VariableFont_wdth,wght.ttf",
            "./assets/fonts/Ionicons.ttf",
            "./assets/fonts/FontAwesome6_Regular.ttf",
            "./assets/fonts/FontAwesome6_Solid.ttf",
            "./assets/fonts/FontAwesome6_Brands.ttf"
          ]
        }
      ],
      "./plugins/withMirloAppLinks"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "797fb379-0d0b-4d23-b827-bb78570fb948"
      }
    },
    "runtimeVersion": "1.0.8",
    "owner": "drhodesw",
    "updates": {
      "url": "https://u.expo.dev/797fb379-0d0b-4d23-b827-bb78570fb948"
    }
  }
}
